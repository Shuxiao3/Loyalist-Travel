{
  "name": "loyalist-travel",
  "version": "0.1.0",
  "private": true,
  "description": "Loyalist Travel: luxury hotel reviews scored on a 100-point rubric. Next.js 15 + Payload 3 + Postgres on Neon.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "npm run migrate && npm run build",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "import:webflow": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env node_modules/.bin/tsx scripts/webflow/import.ts",
    "import:check": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env node_modules/.bin/tsx scripts/webflow/spot-check.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "^3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.11.0",
    "htmlparser2": "^10.1.0",
    "next": "15.4.11",
    "payload": "3.89.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
