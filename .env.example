# Neon Postgres connection string (pooled). The Neon integration on Vercel sets this for you.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Random string of 32+ characters used to sign Payload sessions. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=replace-me

# Public URL of the site, no trailing slash. Used for Payload's serverURL, CORS and CSRF.
# Leave unset on Vercel to derive it from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
